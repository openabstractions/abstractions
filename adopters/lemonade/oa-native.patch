+#ifdef LEMONADE_OA_BRANDED_BUILD
+ assert(mutex_name=="Local\\OpenAbstractions.Lemonade.Router.Mutex");
+#else
+ assert(mutex_name=="Global\\LemonadeRouterMutex");
