+"""Emit inert tests of actual helper bodies; fake hash answers test admission flow.
+No transport, HTTP or crypto backend executes. Usage: py SCRIPT OUTPUT.cpp
+"""
+from pathlib import Path
+import sys
+root = Path(__file__).resolve().parents[1]
+adapter = (root / 'src/cpp/server/openabstractions.cpp').read_text(encoding='utf-8')
+http = (root / 'src/cpp/server/utils/http_client.cpp').read_text(encoding='utf-8')
+model = (root / 'src/cpp/server/model_manager.cpp').read_text(encoding='utf-8')
+assert 'prepare_cached_download(output_path, options)' in http
+assert 'prepare_cached_download(output_path, verification)' in adapter
+assert adapter.index('read_saved_job(sidecar, url, digest)') < adapter.index('prepare_cached_download(output_path, verification)')
+saved = adapter[adapter.index('struct SavedJob {'):adapter.index('std::string new_key(')]
+cache = http[http.index('std::optional<DownloadResult> HttpClient::prepare_cached_download('):http.index('DownloadResult HttpClient::download_file(')]
+prelude = r'''
+#include <filesystem>
+#include <fstream>
+#include <optional>
+#include <string>
+#include <iostream>
+#include <stdexcept>
+#include <cassert>
+namespace fs=std::filesystem;
+namespace utils {std::string path_to_utf8(const fs::path& p){return p.string();}}
+fs::path path_from_utf8(const std::string& p){return fs::u8path(p);}
+#define LOG(...) std::cerr
+struct DownloadOptions {std::string expected_hash,expected_hash_algorithm;};
+struct DownloadResult {bool success=false;size_t bytes_downloaded=0;std::string error_message;};
+struct ExpectedHash {std::string value;bool present()const{return !value.empty();}};
+ExpectedHash parse_expected_hash(const DownloadOptions& o){return {o.expected_hash=="bad-format"?"":o.expected_hash};}
+struct HashResult{bool ok;};
+HashResult verify_file_hash(const fs::path& p,const ExpectedHash& e){std::ifstream f(p);std::string s;std::getline(f,s);return {s==e.value};}
+struct HttpClient{static std::optional<DownloadResult> prepare_cached_download(const std::string&,const DownloadOptions&);};
+'''
+main = r'''
+void put(const fs::path&p,const std::string&s){std::ofstream(p,std::ios::binary)<<s;}
+template<class F>void refuses(F f){bool refused=false;try{f();}catch(const std::exception&){refused=true;}assert(refused);}
+int main(int argc,char**argv){assert(argc==2);fs::path dir=argv[1];fs::create_directories(dir);
+ const auto side=dir/"model.oa-job";assert(!read_saved_job(side,"url","digest"));
+ SavedJob job{"endpoint","owner","key","epoch","url","digest"};write_saved_job(side,job);
+ assert(read_saved_job(side,"url","digest")->key=="key");auto bytes=fs::file_size(side);
+ refuses([&]{read_saved_job(side,"other","digest");});assert(fs::file_size(side)==bytes);
+ refuses([&]{read_saved_job(side,"url","other");});assert(fs::file_size(side)==bytes);
+ put(side,"truncated\n");refuses([&]{read_saved_job(side,"url","digest");});assert(fs::file_size(side)==10);
+ put(side,std::string(65537,'x'));refuses([&]{read_saved_job(side,"url","digest");});
+ job.key="bad\nkey";refuses([&]{write_saved_job(side,job);});assert(fs::file_size(side)==65537);
+ fs::remove(side);const auto file=dir/"model";DownloadOptions opts{"valid","sha256"};
+ assert(!HttpClient::prepare_cached_download(file.string(),opts));
+ put(file,"valid");auto good=HttpClient::prepare_cached_download(file.string(),opts);assert(good&&good->success);
+ put(file.string()+".partial","stale");good=HttpClient::prepare_cached_download(file.string(),opts);assert(good&&good->success&&!fs::exists(file.string()+".partial"));
+ put(file,"invalid");assert(!HttpClient::prepare_cached_download(file.string(),opts));assert(!fs::exists(file));
+ opts.expected_hash="bad-format";auto bad=HttpClient::prepare_cached_download(file.string(),opts);assert(bad&&!bad->success);
+ std::cout<<"PASS saved identity and cached-file admission fixtures\n";fs::remove_all(dir);
+}
+'''
+Path(sys.argv[1]).write_text(prelude + saved + cache + main, encoding='utf-8')
