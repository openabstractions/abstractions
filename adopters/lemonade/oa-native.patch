+"""Emit actual Server.run + pinned cpp-httplib loopback cancellation regressions.
+
+Reuses the existing actual-body harness generator. Its real Front derives from
+the admitted httplib::Server and uses the exact owning close method. Only fault
+barriers/thread-construction injection are substituted. No OA product executes.
+Compile/run the output twice: admitted header-only input, and the configured
+split public header/static library with its actual mbedTLS/zstd usage settings.
+The split form verifies that this owner uses only its receiving symbol surface.
+"""
+from pathlib import Path
+import runpy,sys,tempfile
+r=Path(__file__).resolve().parents[1]
+output=Path(sys.argv[1])
+with tempfile.TemporaryDirectory(prefix='lemonade938-listener-') as tmp:
+    old=sys.argv
+    sys.argv=[str(r/'tests/oa_tray_fixture.py'),str(Path(tmp)/'body.cpp')]
+    try: runpy.run_path(sys.argv[0],run_name='__main__')
+    finally: sys.argv=old
+    all_source=(Path(tmp)/'body.cpp').read_text()
+body=all_source[all_source.index('namespace actual_run {'):all_source.index('namespace signal_receiver {')]
+front=(r/'src/cpp/include/lemon/upgradable_http_server.h').read_text()
+begin=front.index('    void stop_owned_listener() noexcept {')
+end=front.index('\n    }',begin)+len('\n    }')
+close=front[begin:end]
+body=body.replace('int occupied=0,foreign_status=0,foreign_shutdowns=0,fault=0,spawns=0,setups=0;', '''
+int occupied=0,foreign_status=0,foreign_shutdowns=0,fault=0,spawns=0,setups=0;
+std::atomic<bool> barrier{false},release_barrier{false};
+std::atomic<int> closes{0};
+''')
+old='template<class F> std::thread spawn_listener(F f){if(++spawns==fault)throw std::runtime_error("spawn");return std::thread(f);}'
+new='''template<class F> std::thread spawn_listener(F f){
+ ++spawns;
+ if(spawns==2 && (fault==6 || fault==7)) {
+  while(!barrier)std::this_thread::yield();
+  throw std::runtime_error("second spawn with barrier");
+ }
+ if(spawns==fault)throw std::runtime_error("spawn");return std::thread(f);
+}'''
+assert old in body;body=body.replace(old,new)
+start=body.index('struct Front{');end=body.index('\nstruct Routed',start)
+body=body[:start]+'''struct Front:httplib::Server {
+ bool fail=false;
+ void wait_barrier(){barrier=true;while(!release_barrier)std::this_thread::yield();}
+ int bind_to_port(std::string host,int){
+  if(fault==6 || fault==9)wait_barrier();
+  if(fault==5)throw std::runtime_error("worker");
+  if(fail)return 0;
+  int p=httplib::Server::bind_to_any_port(host);
+  if(fault==8)throw std::runtime_error("bound worker");
+  return p;
+ }
+ socket_t listen_socket(){return svr_sock_.load();}
+ bool listen_after_bind(){if(fault==7 || fault==10)wait_barrier();return httplib::Server::listen_after_bind();}
+'''+close+'''
+ void cancel(){stop_owned_listener();if(++closes>=2)release_barrier=true;}
+};'''+body[end:]
+body=body.replace('void set_listen_socket(int)', 'void set_listen_socket(socket_t)')
+body=body.replace('http_front_->stopped=true;http_front_v6_->stopped=true;', 'http_front_->cancel();http_front_v6_->cancel();')
+# Standard source tests include spawn/setup/beacon/worker failures. Add deterministic
+# prebind and bound-before-listen barriers with the actual dependency semantics.
+insert='''
+ for(fault=6;fault<=10;++fault){spawns=setups=0;closes=0;barrier=false;release_barrier=false;
+  Server s;std::thread cancel;
+  if(fault>=9)cancel=std::thread([&]{while(!barrier)std::this_thread::yield();s.shutdown_requested_=true;});
+  bool threw=false;try{s.run();}catch(const std::runtime_error&){threw=true;}
+  if(cancel.joinable())cancel.join();
+  assert(threw==(fault==6 || fault==7));assert(!s.ready_);
+  assert(!s.http_v4_thread_.joinable()&&!s.http_v6_thread_.joinable());
+  assert(s.http_front_->listen_socket()==INVALID_SOCKET);
+  assert(s.http_front_v6_->listen_socket()==INVALID_SOCKET);
+ }
+'''
+body=body.replace(' std::cout<<"PASS actual Server.run',insert+' std::cout<<"PASS actual Server.run')
+prefix='''#include <httplib.h>
+#include <atomic>
+#include <cassert>
+#include <chrono>
+#include <iostream>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <vector>
+'''
+# Use native AF constants supplied by the actual dependency header.
+body=body.replace('constexpr int AF_INET=2,AF_INET6=23;','')
+suffix='''
+int main(){
+ // Demonstrate the pinned stop semantics: neither prebind nor prelisten stop
+ // cancels a bound socket. The admitted owner must close that exact socket.
+ actual_run::Front front;front.stop();
+ assert(front.httplib::Server::bind_to_any_port("127.0.0.1")>0);
+ auto bound=front.listen_socket();front.stop();assert(front.listen_socket()==bound);
+ front.stop_owned_listener();front.stop_owned_listener();assert(front.listen_socket()==INVALID_SOCKET);
+ // An unrelated live listener remains usable across every cleanup/failure case.
+ httplib::Server foreign;std::atomic<int> requests{0};
+ foreign.Get("/",[&](const httplib::Request&,httplib::Response&res){++requests;res.set_content("foreign","text/plain");});
+ int port=foreign.bind_to_any_port("127.0.0.1");assert(port>0);
+ std::thread worker([&]{foreign.listen_after_bind();});foreign.wait_until_ready();
+ actual_run::check();
+ httplib::Client client("127.0.0.1",port);client.set_read_timeout(2);
+ auto response=client.Get("/");assert(response && response->body=="foreign" && requests==1);
+ foreign.stop();worker.join();
+ std::cout<<"PASS pinned httplib prebind/prelisten/repeated close/worker fault/foreign preservation\\n";
+}
+'''
+output.write_text(prefix+body+suffix)
