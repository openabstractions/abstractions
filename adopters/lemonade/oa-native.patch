+namespace fs = std::filesystem;
+namespace oa = abstraction::facade;
+
+namespace {
+
+struct RuntimeSelection {
+    std::mutex mutex;
+    bool configured = false;
+    oa::ResolutionClient resolver;
+};
+
+RuntimeSelection& runtime_selection() {
+    static RuntimeSelection value;
+    return value;
+}
+
+void reject_ambient_runtime() {
+    if (!utils::get_environment_variable_utf8("LEMONADE_OA_RUNTIME_ENDPOINT").empty())
+        throw std::runtime_error("LEMONADE_OA_RUNTIME_ENDPOINT is unsupported: use the verified installed runtime or explicit trusted startup options");
+}
+
+bool bounded_text(const std::string& value, size_t limit) {
+    return !value.empty() && value.size() <= limit &&
+        std::none_of(value.begin(), value.end(), [](unsigned char c) { return c < 32 || c == 127; });
+}
+
+} // namespace
+
+void configure_runtime(const std::string& endpoint, const std::string& program,
+                       const std::string& account) {
+    reject_ambient_runtime();
+    auto& selected = runtime_selection();
+    std::lock_guard<std::mutex> lock(selected.mutex);
+    if (selected.configured) throw std::runtime_error("OA runtime startup selection is already fixed");
+    const bool explicit_selection = !endpoint.empty() || !program.empty() || !account.empty();
+    if (explicit_selection) {
+        if (!bounded_text(endpoint, 4096) || !bounded_text(program, 32768) || !bounded_text(account, 184))
+            throw std::invalid_argument("explicit OA runtime endpoint, program and account must all be nonempty bounded text");
+#ifdef _WIN32
+        // Match the native expectation's local-drive syntax before filesystem IO.
+        if (program.size() < 3 || !((program[0] >= 'A' && program[0] <= 'Z') ||
+            (program[0] >= 'a' && program[0] <= 'z')) || program[1] != ':' ||
+            (program[2] != '/' && program[2] != '\\'))
+            throw std::invalid_argument("explicit OA runtime program must use a local drive path");
+        const auto path = fs::u8path(program);
+        if (!path.is_absolute() || !fs::is_regular_file(path))
+            throw std::invalid_argument("explicit OA runtime program must be an existing absolute executable file");
+        PSID sid = nullptr;
+        if (!ConvertStringSidToSidA(account.c_str(), &sid))
+            throw std::invalid_argument("explicit OA runtime account must be a Windows SID");
+        const bool valid = IsValidSid(sid) != FALSE;
+        LocalFree(sid);
+        if (!valid) throw std::invalid_argument("invalid explicit OA runtime account SID");
+        selected.resolver = oa::ResolutionClient(endpoint).with_server_expectation(
+            abstraction::ipc::ServerExpectation{OA_IPC_PRINCIPAL_WINDOWS_SID, account, program});
+#else
+        throw abstraction::ipc::FrameError("explicit OA runtime account selection is unsupported on this platform",
+                                           abstraction::ipc::Status::ProofUnavailable);
+#endif
+    }
+    selected.configured = true;
+}
+
+namespace {
+
+const std::vector<std::string> kGuarantees = {"abstraction.job/reconciliation@1"};
+
+oa::ResolutionClient make_resolver() {
+    reject_ambient_runtime();
+    auto& selected = runtime_selection();
+    std::lock_guard<std::mutex> lock(selected.mutex);
+    return selected.resolver;
+}
+
+struct SavedJob {
+    std::string endpoint, owner, key, epoch, url, digest;
+};
+
+std::optional<SavedJob> read_saved_job(const fs::path& path, const std::string& url, const std::string& digest) {
+    if (!fs::exists(path)) return std::nullopt;
+    if (fs::file_size(path) > 65536) throw std::runtime_error("saved download identity exceeds its bound");
+    std::ifstream in(path, std::ios::binary);
+    if (!in) throw std::runtime_error("could not read saved download identity");
+    SavedJob job;
+    if (!std::getline(in, job.endpoint) || !std::getline(in, job.owner) || !std::getline(in, job.key) ||
+        !std::getline(in, job.epoch) || !std::getline(in, job.url) || !std::getline(in, job.digest) ||
+        job.endpoint.empty() || job.owner.empty() || job.key.empty() || job.epoch.empty() ||
+        job.url != url || job.digest != digest || in.peek() != std::char_traits<char>::eof()) {
+        throw std::runtime_error("saved download identity is malformed or belongs to different content; preserved for recovery");
+    }
+    return job;
+}
+
+void write_saved_job(const fs::path& path, const SavedJob& job) {
+    for (const auto* field : {&job.endpoint, &job.owner, &job.key, &job.epoch, &job.url, &job.digest}) {
+        if (field->find_first_of("\r\n") != std::string::npos) throw std::runtime_error("invalid newline in saved download identity");
+    }
+    std::ofstream out(path, std::ios::binary | std::ios::trunc);
+    out << job.endpoint << '\n' << job.owner << '\n' << job.key << '\n' << job.epoch << '\n' << job.url << '\n' << job.digest << '\n';
+    out.flush();
+    if (!out) throw std::runtime_error("could not persist job identity to " + utils::path_to_utf8(path));
+}
+
+std::string new_key(const std::string& url) {
+    const auto now = std::chrono::system_clock::now().time_since_epoch().count();
+    return "lemonade-model-" + std::to_string(std::hash<std::string>{}(url)) + "-" + std::to_string(now);
+}
+
+// CopyResult owns protocol validation. This destination only bounds local
+// delivery by the application's existing stop/cancel signals.
+class StoppableResultBuffer : public std::streambuf {
+public:
+    StoppableResultBuffer(std::streambuf* target, std::function<bool(std::uint64_t)> keep_going)
+        : target_(target), keep_going_(std::move(keep_going)) {}
+    bool keep_going() { return keep_going_(written_); }
+protected:
+    std::streamsize xsputn(const char* bytes, std::streamsize size) override {
+        if (!keep_going()) return 0;
+        const auto n = target_->sputn(bytes, size);
+        if (n > 0) written_ += static_cast<std::uint64_t>(n);
+        return n;
+    }
+    int sync() override { return target_->pubsync(); }
+private:
+    std::streambuf* target_;
+    std::function<bool(std::uint64_t)> keep_going_;
+    std::uint64_t written_ = 0;
+};
+
+} // namespace
+
+std::optional<RuntimeRefusal> admit_runtime() {
+#ifdef LEMONADE_OA_DEFAULT_ON
+    for (const char* name : {"LEMONADE_OA_DOWNLOADS", "LEMONADE_OA_LOGGING"}) {
+        if (auto refusal = refuse_switch(name)) return refusal;
+    }
+#endif
+    try {
+        if (logging_enabled()) oa::resolve_log(make_resolver());
+        if (downloads_enabled()) oa::resolve_job_operations(make_resolver(), kGuarantees, oa::Scope::Local);
+    } catch (const oa::ResolutionError& e) {
+        return RuntimeRefusal{e.status, e.what()};
+    } catch (const abstraction::ipc::FrameError& e) {
+        // The caller's own cancellation is not a runtime refusal.
+        if (e.status == abstraction::ipc::Status::Cancelled) throw;
+        return RuntimeRefusal{abstraction::ipc::status_name(e.status), e.what()};
+    }
+    return std::nullopt;
+}
+
+DownloadOutcome download_file(const std::string& url,
+                              const std::string& output_path,
+                              const std::string& expected_hash,
+                              const std::string& expected_hash_algorithm,
+                              const std::function<bool(size_t, size_t)>& progress) {
+    DownloadOutcome outcome;
+    const fs::path output = utils::path_from_utf8(output_path);
+    const fs::path partial = utils::path_from_utf8(output_path + ".partial");
+    const fs::path sidecar = utils::path_from_utf8(output_path + ".oa-job");
+    std::error_code ec;
+    try {
+        const std::string digest = expected_hash_algorithm + ":" + expected_hash;
+        const auto saved = read_saved_job(sidecar, url, digest);
+        utils::DownloadOptions verification;
+        verification.expected_hash = expected_hash;
+        verification.expected_hash_algorithm = expected_hash_algorithm;
+        if (auto cached = utils::HttpClient::prepare_cached_download(output_path, verification)) {
+            outcome.success = cached->success;
+            outcome.error_message = cached->error_message;
+            return outcome;
+        }
+        if (utils::g_download_cancelled.load()) { outcome.cancelled = true; return outcome; }
+        auto resolver = make_resolver();
+        auto selected = oa::resolve_job_operations(resolver, kGuarantees, oa::Scope::Local);
+        std::optional<oa::JobsClient> jobs;
+        oa::job_api::RequestIdentity identity;
+
+        if (saved) {
+            if (saved->endpoint != selected.endpoint()) throw std::runtime_error("saved download binding differs from the installed runtime; preserved for recovery");
+            jobs.emplace(oa::JobsClient(saved->endpoint, 5000, kGuarantees, saved->owner)
+                             .with_server_expectation(resolver.server()));
+            identity = {saved->key, saved->epoch, 0};
+            const auto recovered = jobs->reconcile(identity);
+            if (recovered.outcome != "accepted") {
+                if (recovered.outcome != "definitely_not_accepted") {
+                    throw std::runtime_error("earlier download job is " + std::string(wire_name(recovered.outcome)) +
+                                             "; its identity is kept in " + utils::path_to_utf8(sidecar));
+                }
+                jobs.reset();
+            }
+        }
+
+        if (!jobs) {
+            jobs.emplace(selected);
+            const auto history = jobs->get_history_window();
+            identity = {new_key(url), history.history_epoch, 0};
+
+            abstraction::download::request::Request request;
+            request.sources.push_back({url.rfind("https:", 0) == 0 ? "https" : "http", url});
+            if (expected_hash_algorithm == "sha256" && expected_hash.size() == 64) request.artifact.digest = "sha256:" + expected_hash;
+            const auto payload = abstraction::download::request::encode(request);
+
+            oa::job_api::Submission submission;
+            submission.identity = identity;
+            submission.kind = "download";
+            submission.spec.assign(payload.begin(), payload.end());
+            submission.required_guarantees = kGuarantees;
+
+            write_saved_job(sidecar, {jobs->endpoint(), history.logical_owner, identity.key, identity.history_epoch, url, digest});
+            auto accepted = jobs->submit(submission);
+            if (accepted.outcome != "accepted") accepted = jobs->reconcile(identity);
+            if (accepted.outcome != "accepted") {
+                if (accepted.outcome == "definitely_not_accepted") fs::remove(sidecar, ec);
+                throw std::runtime_error("runtime did not accept the download: " + std::string(wire_name(accepted.outcome)) +
+                                         (accepted.reason.empty() ? "" : " (" + accepted.reason + ")"));
+            }
+        }
+
+        std::uint64_t total = 0;
+        auto keep_going = [&](std::uint64_t done) {
+            if (utils::g_download_cancelled.load()) { outcome.cancelled = true; return false; }
+            if (progress && !progress(static_cast<size_t>(done), static_cast<size_t>(total))) {
+                outcome.cancelled = true;
+                jobs->cancel_work(identity);
+                return false;
+            }
+            return true;
+        };
+        for (;;) {
+            if (utils::g_download_cancelled.load()) { outcome.cancelled = true; return outcome; }
+            const auto observed = jobs->observe_work(identity);
+            if (observed.outcome != "observed" || !observed.snapshot) {
+                throw std::runtime_error("download job observation returned " + std::string(wire_name(observed.outcome)));
+            }
+            const auto& snapshot = *observed.snapshot;
+            total = static_cast<std::uint64_t>(snapshot.progress.total);
+            if (!keep_going(static_cast<std::uint64_t>(snapshot.progress.done))) return outcome;
+            if (snapshot.state == "complete") break;
+            if (snapshot.state == "failed" || snapshot.state == "cancelled") {
+                fs::remove(sidecar, ec);
+                std::string detail = snapshot.failure ? snapshot.failure->message : "";
+                if (snapshot.failure && !snapshot.failure->cause.empty()) detail += " [" + snapshot.failure->cause + "]";
+                throw std::runtime_error("download job " + std::string(wire_name(snapshot.state)) + (detail.empty() ? "" : ": " + detail));
+            }
+            std::this_thread::sleep_for(std::chrono::milliseconds(250));
+        }
+
+        {
+            std::ofstream file(partial, std::ios::binary | std::ios::trunc);
+            StoppableResultBuffer buffer(file.rdbuf(), [&](std::uint64_t) { return keep_going(total); });
+            std::ostream destination(&buffer);
+            const auto copied = jobs->copy_result(identity, destination);
+            if (outcome.cancelled || !buffer.keep_going()) return outcome;
+            if (copied.error) std::rethrow_exception(copied.error);
+            file.close();
+            if (!file) throw std::runtime_error("could not write " + utils::path_to_utf8(partial));
+            outcome.bytes = static_cast<std::uint64_t>(copied.confirmed);
+        }
+        const auto verified = utils::HttpClient::prepare_cached_download(utils::path_to_utf8(partial), verification);
+        if (!verified || !verified->success) throw std::runtime_error(verified ? verified->error_message : "download result failed content verification");
+        fs::rename(partial, output);
+        fs::remove(sidecar, ec);
+        outcome.success = true;
+    } catch (const std::exception& e) {
+        outcome.error_message = std::string("Open Abstractions download failed: ") + e.what();
+    }
+    return outcome;
+}
+
+namespace {
+
+std::int64_t oa_level(AixLog::Severity severity) {
+    switch (severity) {
+    case AixLog::Severity::trace: return -8;
+    case AixLog::Severity::debug: return -4;
+    case AixLog::Severity::info: return 0;
+    case AixLog::Severity::notice: return 2;
+    case AixLog::Severity::warning: return 4;
+    case AixLog::Severity::error: return 8;
+    case AixLog::Severity::fatal: return 12;
+    }
+    return 0;
+}
+
+// AixLog holds its own lock while calling log(). The shared handler owns
+// queueing, retry/rebind, counts and gap reporting; this sink only maps metadata.
+class OpenAbstractionsLogSink : public AixLog::Sink {
+public:
+    explicit OpenAbstractionsLogSink(const AixLog::Filter& filter,
+                                    abstraction::logging::AsyncOptions options = {})
+        : AixLog::Sink(filter) {
+        if (options.program.empty()) options.program = "lemond";
+        const auto token = cancellation_.token();
+        auto resolve = [token] {
+            return oa::resolve_log(make_resolver().with_cancellation(token));
+        };
+        // First binding runs on the delivery thread, outside AixLog's lock.
+        // AsyncHandler copies Writer into each bounded attempt. Retain one
+        // lazy binding across those copies; its writer owner serializes calls.
+        auto binding = std::make_shared<std::optional<abstraction::logging::Logger>>();
+        auto writer = [resolve, binding](const abstraction::logging::Record& record) {
+            if (!*binding) binding->emplace(resolve());
+            (*binding)->write(record);
+        };
+        auto rebind = [resolve]() -> abstraction::logging::AsyncHandler::Writer {
+            auto logger = resolve();
+            return [logger](const abstraction::logging::Record& record) { logger.write(record); };
+        };
+        handler_ = std::make_unique<abstraction::logging::AsyncHandler>(
+            std::move(writer), std::move(rebind), std::move(options));
+    }
+
+    ~OpenAbstractionsLogSink() override {
+        cancellation_.cancel();
+        // Shutdown stops waiting; the common owner accounts failed/abandoned work.
+        handler_->close(std::chrono::milliseconds(0));
+    }
+
+    void log(const AixLog::Metadata& metadata, const std::string& message) override {
+        std::string text = message;
+        while (!text.empty() && (text.back() == '\n' || text.back() == '\r')) text.pop_back();
+        std::map<std::string, std::string> attributes = {{"program", "lemond"}};
+        if (metadata.tag) attributes["component"] = metadata.tag.text;
+        handler_->log(oa_level(metadata.severity), std::move(text), std::move(attributes));
+    }
+
+    abstraction::logging::HandlerCounts counts() const { return handler_->counts(); }
+    abstraction::logging::HandlerCounts close(std::chrono::milliseconds timeout) {
+        return handler_->close(timeout);
+    }
+
+private:
+    abstraction::ipc::CancellationSource cancellation_;
+    std::unique_ptr<abstraction::logging::AsyncHandler> handler_;
+};
+
+} // namespace
+
+std::shared_ptr<AixLog::Sink> make_log_sink(const AixLog::Filter& filter) {
+    return std::make_shared<OpenAbstractionsLogSink>(filter);
+}
+
+#endif
+
+} // namespace lemon::openabstractions

