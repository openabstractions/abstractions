 # Create stamp file to mark successful build
+function(_oa_copy_web_notices MODULES OUTPUT FONT_NOTICE)
+    if(NOT IS_DIRECTORY "${MODULES}" OR IS_SYMLINK "${MODULES}")
+        message(FATAL_ERROR "OA web notices require the lock-installed dependency folder")
+    endif()
+    if(NOT EXISTS "${FONT_NOTICE}" OR IS_DIRECTORY "${FONT_NOTICE}" OR IS_SYMLINK "${FONT_NOTICE}")
+        message(FATAL_ERROR "OA web notices require the full KaTeX font OFL notice")
+    endif()
+    file(READ "${MODULES}/katex/package.json" katex_package)
+    string(JSON katex_version GET "${katex_package}" version)
+    if(NOT katex_version STREQUAL "0.16.45")
+        message(FATAL_ERROR "OA font notice requires its reviewed KaTeX 0.16.45 input")
+    endif()
+    file(REAL_PATH "${MODULES}" modules_real)
+    cmake_policy(PUSH)
+    cmake_policy(SET CMP0009 NEW)
+    file(GLOB_RECURSE candidates LIST_DIRECTORIES FALSE "${MODULES}/*")
+    cmake_policy(POP)
+    set(notices)
+    foreach(source IN LISTS candidates)
+        get_filename_component(name "${source}" NAME)
+        string(TOUPPER "${name}" name)
+        if(name MATCHES "^(LICEN[CS]E|COPYING|NOTICE|COPYRIGHT|COPYRIGHTNOTICE|OFL)([._-].*)?$")
+            file(REAL_PATH "${source}" source_real)
+            string(FIND "${source_real}" "${modules_real}/" inside)
+            if(NOT EXISTS "${source}" OR IS_SYMLINK "${source}" OR IS_DIRECTORY "${source}" OR NOT inside EQUAL 0)
+                message(FATAL_ERROR "OA web notice is not a contained regular file: ${source}")
+            endif()
+            list(APPEND notices "${source}")
+        endif()
+    endforeach()
+    if(NOT notices)
+        message(FATAL_ERROR "OA web dependency notices are missing")
+    endif()
+    # Validate the whole input inventory before refreshing the harvested output.
+    file(REMOVE_RECURSE "${OUTPUT}/licenses")
+    foreach(source IN LISTS notices)
+        file(RELATIVE_PATH relative "${MODULES}" "${source}")
+        configure_file("${source}" "${OUTPUT}/licenses/${relative}" COPYONLY)
+    endforeach()
+    configure_file("${FONT_NOTICE}" "${OUTPUT}/licenses/katex/KaTeX-fonts-OFL.txt" COPYONLY)
+endfunction()
+
+if(LEMONADE_OA_BRANDED_BUILD)
+    if(USE_SYSTEM_NODEJS_MODULES_ENABLED)
+        message(FATAL_ERROR "OA web packaging requires its exact lock-installed dependencies")
+    endif()
+    _oa_copy_web_notices("${WEB_APP_BUILD_SOURCE_DIR}/node_modules" "${WEB_APP_BUILD_DIR}"
+        "${WEB_APP_SOURCE_DIR}/KaTeX-fonts-OFL.txt")
+endif()
+
 file(TOUCH "${WEB_APP_STAMP}")
 message(STATUS "Web app build completed successfully")
