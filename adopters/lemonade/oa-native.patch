+    const auto value = utils::get_environment_variable_utf8(name);
+#ifndef LEMONADE_WITH_OPENABSTRACTIONS
+    return value == "1";
+#elif defined(LEMONADE_OA_DEFAULT_ON)
+    // The OA build runs only through OA (C-77); admit_runtime refuses any other value.
+    if (value.empty() || value == "1") return true;
+    throw std::runtime_error(std::string(name) + "=" + value + " is unsupported in the OA build");
+#else
+    if (value == "1") return true;
+    if (value == "0") return false;
+    if (!value.empty()) throw std::runtime_error(std::string(name) + " must be 0 or 1");
+    return false;
+#endif
