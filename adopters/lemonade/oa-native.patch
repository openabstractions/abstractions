+from pathlib import Path
+import hashlib,re,argparse
+parser=argparse.ArgumentParser(description="Emit pinned LWS actual wake-pipe bodies with the owning OA transform")
+parser.add_argument("--source",type=Path,required=True)
+parser.add_argument("--out",type=Path,required=True)
+args=parser.parse_args()
+r=Path(__file__).resolve().parents[1]
+p=args.source;s=p.read_text()
+cmake=(r/"CMakeLists.txt").read_text()
+old=re.search(r"set\(LWS_PIPE_BIND \[=\[(.*?)\]=\]\)",cmake,re.S).group(1)
+new=re.search(r"set\(LWS_PIPE_BINDS \[=\[(.*?)\]=\]\)",cmake,re.S).group(1)
+assert s.count(old)==1
+s=s.replace(old,new)
+assert s.count(new)==1
+def body(name):
+ start=s.index(name+'(');brace=s.index('{',start);depth=1;i=brace+1
+ while depth:
+  depth+=(s[i]=='{')-(s[i]=='}');i+=1
+ return 'int '+s[start:i]
+text=r'''
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <iphlpapi.h>
+#include <vector>
+#include <cstdio>
+using socklen_t=int;using lws_sockfd_type=SOCKET;
+struct lws_context_per_thread {sockaddr_in frt_pipe_si{};SOCKET dummy_pipe_fds[2]{};};
+struct lws_context {lws_context_per_thread pt[1];};
+struct lws {struct {lws_context*context;}a;int tsi=0;};
+#define lwsl_info(...) ((void)0)
+#define lwsl_err(...) ((void)0)
+'''+body('lws_plat_pipe_create')+'\n'+body('lws_plat_pipe_signal')+r'''
+int main(){WSADATA w;WSAStartup(MAKEWORD(2,2),&w);lws_context ctx{};lws socket{};socket.a.context=&ctx;
+ if(lws_plat_pipe_create(&socket)||lws_plat_pipe_signal(&ctx,0))return 2;
+ sockaddr_in sender{};int n=sizeof(sender);getsockname(ctx.pt[0].dummy_pipe_fds[1],(sockaddr*)&sender,&n);
+ char ip[64];inet_ntop(AF_INET,&sender.sin_addr,ip,sizeof(ip));printf("patched LWS wake sender=%s:%u\n",ip,ntohs(sender.sin_port));
+ DWORD size=0;GetExtendedUdpTable(nullptr,&size,FALSE,AF_INET,UDP_TABLE_OWNER_PID,0);std::vector<char> bytes(size);
+ if(GetExtendedUdpTable(bytes.data(),&size,FALSE,AF_INET,UDP_TABLE_OWNER_PID,0))return 3;
+ auto table=(MIB_UDPTABLE_OWNER_PID*)bytes.data();int own=0;
+ for(DWORD i=0;i<table->dwNumEntries;++i){auto row=table->table[i];if(row.dwOwningPid==GetCurrentProcessId()){++own;if(row.dwLocalAddr!=htonl(INADDR_LOOPBACK))return 6;printf("sockettable ownPID=%lu address=%lu port=%u\n",row.dwOwningPid,row.dwLocalAddr,ntohs((u_short)row.dwLocalPort));}}
+ char wake=1;if(recv(ctx.pt[0].dummy_pipe_fds[0],&wake,1,0)!=1||wake!=0)return 4;
+ sockaddr_in receiver{};n=sizeof(receiver);getsockname(ctx.pt[0].dummy_pipe_fds[0],(sockaddr*)&receiver,&n);if(receiver.sin_addr.s_addr!=htonl(INADDR_LOOPBACK))return 5;
+ closesocket(ctx.pt[0].dummy_pipe_fds[0]);closesocket(ctx.pt[0].dummy_pipe_fds[1]);
+ if(GetExtendedUdpTable(bytes.data(),&size,FALSE,AF_INET,UDP_TABLE_OWNER_PID,0))return 7;
+ table=(MIB_UDPTABLE_OWNER_PID*)bytes.data();for(DWORD i=0;i<table->dwNumEntries;++i)if(table->table[i].dwOwningPid==GetCurrentProcessId())return 8;
+ WSACleanup();printf("PASS both loopback endpoints, wake exchange, socket cleanup\n");
+ return own==2&&sender.sin_addr.s_addr==htonl(INADDR_LOOPBACK)?0:1;
+}
+'''
+args.out.write_text(text)
+print('source SHA256',hashlib.sha256(p.read_bytes()).hexdigest())
