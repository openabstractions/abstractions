+qa = args.qa_root.resolve()
+if not qa.is_relative_to(repo) or qa == repo or qa.exists():
+    raise ValueError('a fresh QA directory inside this checkout is required')
+if hashlib.sha256(args.runtime.read_bytes()).hexdigest() != 'bd258e4c35687e2caabe68e3c156990683eebee75b109f231d50a2facd54ee0c':
+    raise ValueError('signed b745 runtime bytes differ')
+if hashlib.sha256(args.helper.read_bytes()).hexdigest() != '15e789258099ff93421b48d201793f674522eaffb24a922e0a2adef01b179ccb':
+    raise ValueError('reviewed 72209 native adapter helper bytes differ')
+qa.mkdir(parents=True)
+endpoint = r'\\.\pipe\lemonade938-restart-receiver'
+namespace = 'lemonade938-restart-receiver'
+env = {k: v for k, v in os.environ.items() if not k.startswith(
+    ('ABSTRACTION_', 'OPENABSTRACTIONS_', 'LEMONADE_', 'HF_'))}
+client_env = dict(env, ABSTRACTION_RUNTIME_ENDPOINT=endpoint)
+packet = {'scope': 'QA receiving deadline only; product logic 72209 unchanged',
+          'helper_sha256': hashlib.sha256(args.helper.read_bytes()).hexdigest(),
+          'runtime_sha256': hashlib.sha256(args.runtime.read_bytes()).hexdigest(),
+          'events': [], 'processes': [], 'results': []}
+
+def event(name, **values):
+    packet['events'].append(dict(name=name, utc=dt.datetime.now(dt.timezone.utc).isoformat(),
+                                 monotonic=time.monotonic(), **values))
+
+class Handler(http.server.BaseHTTPRequestHandler):
+    def do_GET(self):
+        event('http-request', path=self.path, headers=dict(self.headers))
+        time.sleep(2)  # The fixture's explicit maximum response delay.
+        try:
+            self.send_response(200)
+            self.send_header('Content-Length', '3')
+            self.end_headers()
+            self.wfile.write(b'abc')
+            event('http-complete')
+        except (BrokenPipeError, ConnectionResetError):
+            event('http-disconnected')
+    def log_message(self, *unused):
