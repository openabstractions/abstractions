+// Inert native owner fixture: folder metadata and mutex calls are controlled.
+#include <windows.h>
+#include <shlobj.h>
+#include <cassert>
+#include <cstring>
+#include <iostream>
+static int folder_calls=0;
+static bool refuse_folder=false;
+static HRESULT fixture_folder(REFKNOWNFOLDERID id,DWORD flags,HANDLE,PWSTR* out) {
+    assert(id==FOLDERID_LocalAppData && flags==KF_FLAG_DONT_VERIFY);
+    ++folder_calls;
+    if (refuse_folder) return E_FAIL;
+    const wchar_t value[]=L"C:\\fixture-local";
+    *out=static_cast<PWSTR>(CoTaskMemAlloc(sizeof(value)));
+    std::memcpy(*out,value,sizeof(value));return S_OK;
+}
+#define SHGetKnownFolderPath fixture_folder
+#include "../src/cpp/server/utils/platform/path_windows.cpp"
+#undef SHGetKnownFolderPath
+static std::string mutex_name;
+static HANDLE fixture_mutex(LPSECURITY_ATTRIBUTES,BOOL,LPCSTR name){mutex_name=name;return reinterpret_cast<HANDLE>(1);}
+static DWORD fixture_error(){return ERROR_SUCCESS;}
+#define CreateMutexA fixture_mutex
+#define GetLastError fixture_error
+#include "lemon/single_instance.h"
+#undef CreateMutexA
+#undef GetLastError
+class FixturePath : public lemon::utils::WindowsPathPlatform {
+    std::string get_environment_variable_utf8(const std::string&) override{return "C:\\fixture-profile";}
+};
+int main(){FixturePath p;
+ assert(p.get_cache_dir("C:\\explicit-cache")=="C:\\explicit-cache");
+ assert(p.get_config_dir("C:\\explicit-config")=="C:\\explicit-config");
+ assert(folder_calls==0);
+#ifdef LEMONADE_OA_BRANDED_BUILD
+ assert(p.get_cache_dir("")=="C:\\fixture-local\\LemonadeOA\\cache");
+ assert(p.get_config_dir("")=="C:\\fixture-local\\LemonadeOA\\config");
+ assert(folder_calls==2);
+ refuse_folder=true;
+ bool refused=false;try{p.get_config_dir("");}catch(const std::runtime_error&){refused=true;}
+ assert(refused);
+ refuse_folder=false;
+#else
+ assert(p.get_cache_dir("")=="C:\\fixture-profile\\.cache\\lemonade");
+ assert(p.get_config_dir("")=="C:\\fixture-profile\\.config\\lemonade");
+ assert(folder_calls==0);
+#endif
