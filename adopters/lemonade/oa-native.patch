+#ifdef LEMONADE_OA_DEFAULT_ON
+std::optional<RuntimeRefusal> refuse_switch(const char* name) {
+    const auto value = utils::get_environment_variable_utf8(name);
+    if (value.empty() || value == "1") return std::nullopt;
+    if (value == "0")
+        return RuntimeRefusal{"integration_disabled", std::string(name) +
+            "=0: the OA build downloads and logs only through Open Abstractions"};
+    return RuntimeRefusal{"invalid_configuration", std::string(name) + " must be unset or 1 in the OA build"};
+}
+#endif
