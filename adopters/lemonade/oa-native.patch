diff --git a/src/cpp/include/lemon/openabstractions.h b/src/cpp/include/lemon/openabstractions.h
new file mode 100644
--- /dev/null
+++ b/src/cpp/include/lemon/openabstractions.h
@@ -0,0 +1,66 @@
+#pragma once
+
+#include "lemon/utils/aixlog.hpp"
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <optional>
+#include <string>
+
+namespace lemon::openabstractions {
+
+// LEMONADE_OA_DOWNLOADS=1 and LEMONADE_OA_LOGGING=1 route model downloads and
+// log records through an Open Abstractions runtime. The OA branded build has
+// both always on and refuses at startup when either is set to anything but 1.
+// Other OA-linked builds default off and refuse values other than 0 or 1.
+// The installed runtime is selected with identity checks. Raw runtime endpoint
+// overrides are refused because they carry no independent server authority.
+#ifdef LEMONADE_WITH_OPENABSTRACTIONS
+// Called once by the startup parser before any OA sink or download can run.
+void configure_runtime(const std::string& endpoint, const std::string& program,
+                       const std::string& account);
+
+// Why Lemonade cannot run with OA as configured. status is the SDK's
+// resolution word (runtime_unavailable, upgrade_in_progress, a resolver
+// refusal), the IPC status name (untrusted, proof_unavailable, ...),
+// integration_disabled for an OA build switch set to 0, or
+// invalid_configuration.
+struct RuntimeRefusal {
+    std::string status;
+    std::string detail;
+};
+
+// Exit status of every startup refusal (sysexits EX_UNAVAILABLE).
+inline constexpr int kRuntimeRefusalExit = 69;
+
+// Resolves each enabled OA service once, after configure_runtime. Returns the
+// refusal when the runtime cannot serve one; nullopt when every enabled
+// service resolved or none is enabled. The OA build has no off switch and
+// never falls back to Lemonade's own HTTP downloads or local-only logging.
+std::optional<RuntimeRefusal> admit_runtime();
+#endif
+bool downloads_enabled();
+bool logging_enabled();
+
+struct DownloadOutcome {
+    bool success = false;
+    bool cancelled = false;
+    std::string error_message;
+    std::uint64_t bytes = 0;
+};
+
+// The runtime owns transfer, retry and digest verification. The result bytes
+// are copied to output_path when the durable job completes. The job identity
+// is persisted beside the output so a restarted Lemonade observes the same job
+// instead of starting another transfer.
+DownloadOutcome download_file(const std::string& url,
+                              const std::string& output_path,
+                              const std::string& expected_hash,
+                              const std::string& expected_hash_algorithm,
+                              const std::function<bool(size_t, size_t)>& progress);
+
+std::shared_ptr<AixLog::Sink> make_log_sink(const AixLog::Filter& filter);
+
+} // namespace lemon::openabstractions
