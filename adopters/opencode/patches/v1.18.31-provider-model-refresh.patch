+import { afterEach, beforeEach, expect } from "bun:test"
+import path from "path"
+import { pathToFileURL } from "node:url"
+import { streamText } from "ai"
+import { LayerNode } from "@opencode-ai/core/effect/layer-node"
+import { FSUtil } from "@opencode-ai/core/fs-util"
+import { Effect, Fiber } from "effect"
+import { Auth } from "@/auth"
+import { Config } from "@/config/config"
+import { Env } from "@/env"
+import { Plugin } from "@/plugin"
+import { Provider } from "@/provider/provider"
+import { ModelsDev } from "@opencode-ai/core/models-dev"
+import { RuntimeFlags } from "@/effect/runtime-flags"
+import { ModelV2 } from "@opencode-ai/core/model"
+import { ProviderV2 } from "@opencode-ai/core/provider"
+import { disposeAllInstances } from "../fixture/fixture"
+import { markPluginDependenciesReady } from "../fixture/plugin"
+import { enqueueRefreshPlan, model, resetRefreshPlans } from "../fixture/provider-model-refresh-state"
+import { testEffect } from "../lib/effect"
+
+beforeEach(() => resetRefreshPlans())
+
+afterEach(async () => {
+  await disposeAllInstances()
+})
+
+const providerID = ProviderV2.ID.make("oa-hot-refresh-fixture")
+const pluginURL = pathToFileURL(path.join(import.meta.dir, "../fixture/provider-model-refresh-plugin.ts")).href
+const it = testEffect(
+  LayerNode.compile(
+    LayerNode.group([
+      Provider.node,
+      FSUtil.node,
+      Env.node,
+      Config.node,
+      Auth.node,
+      Plugin.node,
+      ModelsDev.node,
+      RuntimeFlags.node,
+    ]),
+    [[RuntimeFlags.node, RuntimeFlags.layer()]],
+  ),
+)
+
+it.instance(
+  "refreshes a custom provider catalog while its current stream completes",
+  Effect.gen(function* () {
+    const provider = yield* Provider.Service
+    const item = yield* provider.getProvider(providerID)
+    const retired = yield* provider.getModel(providerID, ModelV2.ID.make("retired-model"))
+    let markStarted!: () => void
+    const fetchStarted = new Promise<void>((resolve) => (markStarted = resolve))
+    let releaseResponse!: (response: Response) => void
+    const responsePending = new Promise<Response>((resolve) => (releaseResponse = resolve))
+    item.options.fetch = async () => {
+      markStarted()
+      return responsePending
+    }
+
+    const active = yield* provider.getModel(providerID, ModelV2.ID.make("active-model"))
+    const language = yield* provider.getLanguage(active)
+    const generation = streamText({
+      model: language,
+      messages: [{ role: "user", content: "finish this request" }],
+    })
+    const text = generation.text
+    yield* Effect.promise(() => fetchStarted)
+
+    enqueueRefreshPlan(() =>
+      Promise.resolve({
+        "active-model": model("active-model", {
+          api: { id: "active-model-v2", url: "https://refresh.test/v1", npm: "@ai-sdk/openai-compatible" },
+        }),
+        "new-model": model("new-model"),
+      }),
+    )
+    const refreshed = yield* provider.refreshModels(providerID)
+    expect(refreshed).not.toBe(item)
+    expect(refreshed.models["active-model"]).toBeDefined()
+    expect(refreshed.models["new-model"]).toBeDefined()
+    expect(refreshed.models["retired-model"]).toBeUndefined()
+    expect(yield* provider.defaultModel()).toEqual({ providerID, modelID: ModelV2.ID.make("active-model") })
+    expect((yield* provider.getModel(providerID, retired.id).pipe(Effect.exit))._tag).toBe("Failure")
+    const refreshedModel = yield* provider.getModel(providerID, ModelV2.ID.make("active-model"))
+    expect(refreshedModel.api.id).toBe("active-model-v2")
+    const refreshedLanguage = yield* provider.getLanguage(refreshedModel)
+    expect(refreshedLanguage).not.toBe(language)
+    expect((refreshedLanguage as { modelId: string }).modelId).toBe("active-model-v2")
+
+    const sse = ['data: {"choices":[{"delta":{"content":"completed"}}]}', "", "data: [DONE]", ""].join("\n")
+    releaseResponse(new Response(sse, { headers: { "content-type": "text/event-stream" } }))
+    expect(yield* Effect.promise(() => text)).toBe("completed")
+
+    const beforeFailure = yield* provider.getProvider(providerID)
+    enqueueRefreshPlan(async () => {
+      throw new Error("fixture refresh failure")
+    })
+    const failure = yield* provider.refreshModels(providerID).pipe(Effect.exit)
+    expect(failure._tag).toBe("Failure")
+    expect(yield* provider.getProvider(providerID)).toBe(beforeFailure)
+    expect((yield* provider.getProvider(providerID)).models["new-model"]).toBeDefined()
+    expect((yield* provider.getProvider(providerID)).models["active-model"]).toBeDefined()
+  }),
+  {
+    init: (directory) => Effect.promise(() => markPluginDependenciesReady(path.join(directory, ".opencode"))),
+    config: {
+      model: "oa-hot-refresh-fixture/active-model",
+      plugin: [pluginURL],
+      provider: {
+        "oa-hot-refresh-fixture": {
+          name: "OA Refresh Fixture",
+          npm: "@ai-sdk/openai-compatible",
+          api: "https://refresh.test/v1",
+          options: { apiKey: "test-key", baseURL: "https://refresh.test/v1" },
+          models: {
+            "active-model": {
+              name: "Active Model",
+              tool_call: true,
+              limit: { context: 4096, output: 512 },
+            },
+          },
+        },
+      },
+    },
+  },
+  30000,
+)
+
+it.instance(
+  "keeps the newest refresh generation when callbacks finish out of order, including after a newer failure",
+  Effect.gen(function* () {
+    const provider = yield* Provider.Service
+    const original = yield* provider.getProvider(providerID)
+    let startedA!: () => void
+    const aStarted = new Promise<void>((resolve) => (startedA = resolve))
+    let releaseA!: () => void
+    const aGate = new Promise<void>((resolve) => (releaseA = resolve))
+    enqueueRefreshPlan(async () => {
+      startedA()
+      await aGate
+      return { "older-model": model("older-model") }
+    })
+    const refreshA = yield* provider.refreshModels(providerID).pipe(Effect.forkChild)
+    yield* Effect.promise(() => aStarted)
+
+    let startedB!: () => void
+    const bStarted = new Promise<void>((resolve) => (startedB = resolve))
+    enqueueRefreshPlan(async () => {
+      startedB()
+      return { "newer-model": model("newer-model") }
+    })
+    const refreshB = yield* provider.refreshModels(providerID).pipe(Effect.forkChild)
+    yield* Effect.promise(() => bStarted)
+    const resultB = yield* Fiber.join(refreshB)
+    expect(resultB.models["newer-model"]).toBeDefined()
+    releaseA()
+    const resultA = yield* Fiber.join(refreshA)
+    expect(resultA).toBe(resultB)
+    expect((yield* provider.getProvider(providerID)).models["older-model"]).toBeUndefined()
+
+    let startedC!: () => void
+    const cStarted = new Promise<void>((resolve) => (startedC = resolve))
+    let releaseC!: () => void
+    const cGate = new Promise<void>((resolve) => (releaseC = resolve))
+    enqueueRefreshPlan(async () => {
+      startedC()
+      await cGate
+      return { "stale-model": model("stale-model") }
+    })
+    const refreshC = yield* provider.refreshModels(providerID).pipe(Effect.forkChild)
+    yield* Effect.promise(() => cStarted)
+    enqueueRefreshPlan(async () => {
+      throw new Error("newest refresh failed")
+    })
+    const failedD = yield* provider.refreshModels(providerID).pipe(Effect.exit)
+    expect(failedD._tag).toBe("Failure")
+    releaseC()
+    const resultC = yield* Fiber.join(refreshC)
+    expect(resultC).toBe(resultB)
+    expect(yield* provider.getProvider(providerID)).toBe(resultB)
+    expect(yield* provider.getProvider(providerID)).not.toBe(original)
+  }),
+  {
+    init: (directory) => Effect.promise(() => markPluginDependenciesReady(path.join(directory, ".opencode"))),
+    config: {
+      model: "oa-hot-refresh-fixture/active-model",
+      plugin: [pluginURL],
+      provider: {
+        "oa-hot-refresh-fixture": {
