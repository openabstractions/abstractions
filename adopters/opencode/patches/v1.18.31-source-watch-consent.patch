diff --git a/packages/tui/test/permission-disclosure.test.ts b/packages/tui/test/permission-disclosure.test.ts
new file mode 100644
index 0000000..58d1594
--- /dev/null
+++ b/packages/tui/test/permission-disclosure.test.ts
@@ -0,0 +1,41 @@
+import { expect, test } from "bun:test"
+import { canSelectPermission, permissionChoices, sourceDisclosure } from "../src/routes/session/permission-disclosure"
+
+test("source and share approvals expose exact bounded disclosure text", () => {
+  const read = {
+    permission: "openabstractions_log_source_read",
+    patterns: ['Read source "fixture/system" for up to 1000 ms, at most 1 records and 4096 bytes. The watch returns counts and status unless event sharing is separately approved.'],
+    always: [],
+  }
+  const share = {
+    permission: "openabstractions_log_source_share",
+    patterns: ["Share native event messages, attributes and unverified producer claims from source \"fixture/system\" observed during the next 1000 ms, up to 1 records and 4096 bytes, with this assistant's model. The model route may use a hosted provider."],
+    always: [],
+  }
+  expect(sourceDisclosure(read)).toEqual({ title: "Read log source", detail: read.patterns[0], valid: true })
+  expect(sourceDisclosure(share)).toEqual({ title: "Share log events with assistant", detail: share.patterns[0], valid: true })
+  expect(permissionChoices(read)).toEqual({ once: "Allow once", reject: "Reject" })
+  expect(permissionChoices(share)).toEqual({ once: "Allow once", reject: "Reject" })
+  expect(canSelectPermission(share, "always")).toBe(false)
+  expect(canSelectPermission(share, "once")).toBe(true)
+})
+
+test("missing, ambiguous, oversized and control-bearing disclosures cannot be approved", () => {
+  const invalid = [[], [""], ["A".repeat(513)], ["Read\nsource"], ["Share \u202eevents"], ["one", "two"]]
+  for (const patterns of invalid) {
+    const request = { permission: "openabstractions_log_source_share", patterns, always: ["*"] }
+    expect(sourceDisclosure(request)?.valid).toBe(false)
+    expect(permissionChoices(request)).toEqual({ reject: "Reject" })
+    expect(canSelectPermission(request, "once")).toBe(false)
+    expect(canSelectPermission(request, "always")).toBe(false)
+    expect(canSelectPermission(request, "reject")).toBe(true)
+  }
+})
+
+test("other permissions retain their display path and valid always choice", () => {
+  const repeatable = { permission: "read", patterns: ["src/*"], always: ["src/*"] }
+  expect(sourceDisclosure(repeatable)).toBeUndefined()
+  expect(permissionChoices(repeatable)).toEqual({ once: "Allow once", always: "Allow always", reject: "Reject" })
+  expect(canSelectPermission(repeatable, "always")).toBe(true)
+  expect(permissionChoices({ ...repeatable, always: [] })).toEqual({ once: "Allow once", reject: "Reject" })
+})
