+type Request = {
+  permission: string
+  patterns?: readonly string[]
+  always?: readonly string[]
+}
+
+const sourceRead = "openabstractions_log_source_read"
+const sourceShare = "openabstractions_log_source_share"
+
+export function sourceDisclosure(request: Request) {
+  if (request.permission !== sourceRead && request.permission !== sourceShare) return
+  const pattern = request.patterns?.[0]
+  const valid = request.patterns?.length === 1 && typeof pattern === "string" && pattern.length > 0 &&
+    pattern.length <= 512 && !/[^\x20-\x7e]/.test(pattern)
+  return {
+    title: request.permission === sourceRead ? "Read log source" : "Share log events with assistant",
+    detail: valid ? pattern : "Required disclosure is missing or invalid. Reject this request.",
+    valid,
+  }
+}
+
+export function permissionChoices(request: Request): Record<string, string> {
+  if (sourceDisclosure(request)?.valid === false) return { reject: "Reject" }
+  if (!request.always?.length) return { once: "Allow once", reject: "Reject" }
+  return { once: "Allow once", always: "Allow always", reject: "Reject" }
+}
+
+export function canSelectPermission(request: Request, option: string) {
+  if (option === "reject") return true
+  if (sourceDisclosure(request)?.valid === false) return false
+  if (option === "always") return Boolean(request.always?.length)
+  return option === "once"
+}
