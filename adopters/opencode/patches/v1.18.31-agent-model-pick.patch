+type ModelRef = { providerID: string; modelID: string }
+
+/** A model picked for an agent, with the configured model it replaced. */
+export type SavedPick = ModelRef & { over: string }
+
+/** The per-agent picks saved in model.json, keeping well-formed entries. */
+export function persistedAgentModels(value: unknown): Record<string, SavedPick> {
+  const result: Record<string, SavedPick> = {}
+  if (!value || typeof value !== "object" || Array.isArray(value)) return result
+  for (const [agent, pick] of Object.entries(value as Record<string, unknown>)) {
+    if (!pick || typeof pick !== "object") continue
+    const { providerID, modelID, over } = pick as Record<string, unknown>
+    if (typeof providerID !== "string" || !providerID || typeof modelID !== "string" || !modelID) continue
+    if (typeof over !== "string") continue
+    result[agent] = { providerID, modelID, over }
+  }
+  return result
+}
+
+/** A saved pick holds while the configuration still names the model it
+ * replaced; a new configured model for the agent drops it. */
+export function savedPick(pick: SavedPick | undefined, configured: string): ModelRef | undefined {
+  if (!pick || pick.over !== configured) return undefined
+  return { providerID: pick.providerID, modelID: pick.modelID }
+}
+
+/** The global config patch that makes model the default for agent. */
+export function agentDefaultPatch(agent: string, model: ModelRef) {
+  return { agent: { [agent]: { model: `${model.providerID}/${model.modelID}` } } }
+}
