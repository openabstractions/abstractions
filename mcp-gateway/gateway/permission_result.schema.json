{
  "type": "object",
  "properties": {
    "outcome": {"type": "string", "enum": ["awaiting_permission", "permission_refused", "permission_blocked"]},
    "question_ids": {"type": "array", "items": {"type": "string"}},
    "message": {"type": "string", "minLength": 1}
  },
  "required": ["outcome", "question_ids", "message"],
  "additionalProperties": false,
  "allOf": [{
    "if": {"properties": {"outcome": {"const": "permission_blocked"}}},
    "else": {"properties": {"question_ids": {"minItems": 1}}}
  }]
}
